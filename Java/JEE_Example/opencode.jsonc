{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/devstral-small-2",

  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },

    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },

    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },

    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "npm test *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "npm run test *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "npm run lint *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "npm run build *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },

    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },

    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    }
  ]
}